{
  "selection_model": {
    "element_shelf": "catalog/views/by_element/{Element}/",
    "coherent_family": "catalog/views/by_family/{family_id}/",
    "system_selection": "python tools/select_system_pp.py --elements ... --task ..."
  },
  "task_rules": {
    "relax": [
      "sssp_v2_pbe_efficiency",
      "sg15_oncv_pbe_sr",
